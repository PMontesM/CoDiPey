{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cobro-codi-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cobro-db",
      "database_id": "4253a4d7-dbb3-4fd7-ad40-3b0024d3c55f",
      "migrations_dir": "migrations"
    }
  ]
}
