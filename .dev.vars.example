# Copia a .dev.vars para `npm run dev` / tests locales con wrangler.
# .dev.vars está en .gitignore (no se sube).

PEY_API_KEY=replace-with-pey-api-key
PEY_WEBHOOK_SECRET=replace-with-pey-webhook-secret
FACTURAPI_KEY=replace-with-facturapi-key
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SANDBOX_JOIN_CODE=replace-with-sandbox-join-code
# TWILIO_SMS_FROM=+15005550006

PUBLIC_URL=http://127.0.0.1:8787
BUSINESS_NAME=Mostrito

# Opcional (panel abierto si falta):
# ADMIN_API_SECRET=replace-with-long-random-string
# FILE_SIGNING_SECRET=replace-with-another-long-random

# Superadmin local:
SUPERADMIN_SECRET=replace-with-long-random-string
