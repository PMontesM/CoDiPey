{
  "name": "cobro-whatsapp-codi",
  "private": true,
  "version": "2.0.0",
  "description": "WhatsApp + CoDi + CFDI 4.0 — Cloudflare Worker (D1)",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply cobro-db --local",
    "db:seed:local": "node scripts/seed-presentacion.mjs --local",
    "db:seed:remote": "node scripts/seed-presentacion.mjs --remote",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-live.mjs",
    "check": "npm run test && npm run smoke"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  }
}
