# === pey (CoDi) ===
# API key del portal https://portal.mipey.mx
PEY_API_KEY=pey_live_xxxxxxxxxxxxxxxx
# Secreto Standard Webhooks (whsec_…) al crear el webhook en portal.mipey.mx
PEY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# === Twilio WhatsApp ===
# Credenciales de https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Número sandbox o productivo, p.ej. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Código del Sandbox (sin la palabra "join"), visible en Twilio Console → WhatsApp Sandbox
TWILIO_SANDBOX_JOIN_CODE=two-words-here
# Opcional: número Twilio SMS (E.164) para mandar la instrucción antes del join
# TWILIO_SMS_FROM=+15005550006

# === Facturapi (CFDI 4.0) ===
# Sandbox o live key de https://www.facturapi.io
FACTURAPI_KEY=sk_test_xxxxxxxxxxxxxxxx

# === Operador / archivos firmados ===
# Token para panel y APIs cuando no hay identidad Cursor (workers.dev).
ADMIN_API_SECRET=change-me-long-random
# Opcional: HMAC de facturas; si falta, usa ADMIN_API_SECRET o PEY_WEBHOOK_SECRET
# FILE_SIGNING_SECRET=another-long-random

# === URL pública del Worker (fija) ===
# En producción es la URL *.workers.dev. No uses tunnels trycloudflare.
PUBLIC_URL=https://cobro-codi.inomali.workers.dev
