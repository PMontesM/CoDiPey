# === pey (CoDi) ===
# API key del portal https://portal.mipey.mx
PEY_API_KEY=pey_live_xxxxxxxxxxxxxxxx

# === Twilio WhatsApp ===
# Credenciales de https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Número sandbox o productivo, p.ej. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# === Facturapi (CFDI 4.0) ===
# Sandbox o live key de https://www.facturapi.io
FACTURAPI_KEY=sk_test_xxxxxxxxxxxxxxxx

# === URL pública (cloudflared / ngrok) ===
# Debe ser alcanzable por Twilio y pey para webhooks y archivos QR
PUBLIC_URL=https://tu-tunel.trycloudflare.com
