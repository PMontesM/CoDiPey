# Mostrito — copia a .env y rellena.
# Los valores de abajo son PLACEHOLDERS, no claves reales.
# En Cloudflare usa: npx wrangler secret put NOMBRE

# === pey (rail CoDi Banxico) ===
# portal.mipey.mx → API key
PEY_API_KEY=replace-with-pey-api-key
# portal.mipey.mx → secreto del webhook (Standard Webhooks)
PEY_WEBHOOK_SECRET=replace-with-pey-webhook-secret

# === Twilio WhatsApp ===
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SANDBOX_JOIN_CODE=replace-with-sandbox-join-code
# Opcional:
# TWILIO_SMS_FROM=+15005550006

# === Facturapi (CFDI 4.0) ===
FACTURAPI_KEY=replace-with-facturapi-key

# === Operador / archivos ===
# Si NO defines ADMIN_API_SECRET, el panel queda abierto (modo demo single-tenant).
# Si lo defines, en /admin → Token pegas el mismo valor.
# ADMIN_API_SECRET=replace-with-long-random-string
# Opcional; si falta y hay ADMIN_API_SECRET o PEY_WEBHOOK_SECRET, se usan para firmar PDF/XML.
# FILE_SIGNING_SECRET=replace-with-another-long-random

# === URL pública del Worker ===
PUBLIC_URL=https://cobro-codi.inomali.workers.dev

# === Superadmin (/superadmin) ===
# Una sola vez en Wrangler (NO se edita desde D1). Desbloquea la UI para
# pisar APIs/webhooks/nombre del negocio sin redeploy.
# npx wrangler secret put SUPERADMIN_SECRET
# SUPERADMIN_SECRET=replace-with-long-random-string
# Nombre del comercio en tickets / WhatsApp (también editable en /superadmin):
# BUSINESS_NAME=Mostrito
